+static void draw_raindrop(uint32_t height)
+{
+    uint32_t logo_scale = 2;
+    if (gWidth > 800) logo_scale = 3;
+    if (gWidth > height) logo_scale = 1;
+    uint32_t logo_scaler_factor = 2 * logo_scale;
+    if (socnum == 0x8012) logo_scaler_factor = 1;
+
+    uint32_t logo_x_begin = (gRowPixels / 2) - (16 * logo_scaler_factor);
+    uint32_t logo_y_begin = (height / 2) - (16 * logo_scaler_factor);
+
+    for (uint32_t y = 0; y < (32 * logo_scaler_factor); ++y) {
+        uint32_t target_y = logo_y_begin + y;
+        if (target_y >= gHeight) continue;
+        uint32_t b = gLogoBitmap[y / logo_scaler_factor];
+        for (uint32_t x = 0; x < (32 * logo_scaler_factor); ++x) {
+            uint32_t target_x = logo_x_begin + x;
+            if (target_x >= gWidth) continue;
+            uint32_t ind = target_x + (target_y * gRowPixels);
+            uint32_t curcolor = gFramebuffer[ind];
+            if (b & (1 << (x / logo_scaler_factor))) {
+                curcolor ^= 0xFFFFFFFF;
+            }
+            gFramebuffer[ind] = curcolor;
+        }
+    }
+}
+
+int screen_apply_background(const uint8_t* rgb, uint32_t image_size, uint32_t image_width, uint32_t image_height)
+{
+    uint64_t expected_size = (uint64_t)image_width * image_height * 3;
+    uint32_t crop_width = image_width;
+    uint32_t crop_height = image_height;
+    uint32_t crop_x = 0;
+    uint32_t crop_y = 0;
+
+    if (!rgb || !gFramebuffer || !gFramebufferCopy || !gWidth || !gHeight || !gRowPixels ||
+        !image_width || !image_height || image_width > 1024 || image_height > 1024 ||
+        expected_size != image_size) {
+        return -1;
+    }
+
+    if ((uint64_t)image_width * gHeight > (uint64_t)image_height * gWidth) {
+        crop_width = (uint32_t)(((uint64_t)image_height * gWidth) / gHeight);
+        crop_x = (image_width - crop_width) / 2;
+    } else {
+        crop_height = (uint32_t)(((uint64_t)image_width * gHeight) / gWidth);
+        crop_y = (image_height - crop_height) / 2;
+    }
+    if (!crop_width || !crop_height) return -1;
+
+    for (uint32_t y = 0; y < gHeight; ++y) {
+        uint32_t source_y = crop_y + (uint32_t)(((uint64_t)y * crop_height) / gHeight);
+        for (uint32_t x = 0; x < gWidth; ++x) {
+            uint32_t source_x = crop_x + (uint32_t)(((uint64_t)x * crop_width) / gWidth);
+            uint64_t source_index = ((uint64_t)source_y * image_width + source_x) * 3;
+            uint32_t pixel = 0xff000000 |
+                ((uint32_t)rgb[source_index + 2] << 16) |
+                ((uint32_t)rgb[source_index + 1] << 8) |
+                (uint32_t)rgb[source_index + 0];
+            gFramebuffer[x + y * gRowPixels] = pixel;
+        }
+    }
+
+    draw_raindrop(gHeight & 0xfff0);
+    memcpy(gFramebufferCopy, gFramebuffer, (size_t)gHeight * gRowPixels * sizeof(uint32_t));
+    basecolor = gFramebuffer[0];
+    cache_clean(gFramebuffer, gHeight * gRowPixels * sizeof(uint32_t));
+    return 0;
+}
